{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "debian_small"
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "red",
      "title": "red"
    }
  },
  "modules": [
    "title",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "memory",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
