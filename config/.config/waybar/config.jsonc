{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 6,

  "modules-left": ["custom/logo", "sway/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [ "tray", "idle_inhibitor", "mpd", "pulseaudio", "custom/network", "custom/weather", "battery"],

  "clock": {
      "format": "{:%H:%M}",
      "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "sway/workspaces": {
    "format": "⬤",
    "format-focused": "⬤",
    "format-urgent": "⬤"
	},

  "battery": {
    "format": " {capacity}%",
    "format-charging": " {capacity}%",
    "format-warning": " {capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    }
  },

  "mpd": {
    "format": "{stateIcon} {title}",
    "tooltip-format": "{album} - {artist} - {title}",
    "max-length": 10,
    "on-click": "mpc toggle",
    "on-click-right": "mpc next",
    "state-icons": {
        "paused": "",
        "playing": ""
    },
    "format-stopped": "\uf04d"
  },
  
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
        "activated": "\uf06e",
        "deactivated": "\uf070"
    }
},

  "network": {
      "format-wifi": " {essid}",
      "format-ethernet": "\uf796 {ifname}",
      "format-disconnected": "󰖪 disconnected",
      "tooltip-format": "{ifname} {ipaddr}/{cidr}",
      "max-length": 10,
      "on-click": "nm-connection-editor"
  },

  "custom/network": {
    "exec": "~/.config/waybar/network.sh",
    "interval": 10,
    "return-type": "json",
    "format": "  {text} "
  },

  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": " mute",
    "on-click": "pavucontrol"
  },

  "tray": {
    "spacing": 8
  },

  "custom/logo": {
      "format": "\uf3a4",
      "tooltip": false
  },
  "custom/weather": {
      "exec": "~/scripts/weather.sh",
      "interval": 1800,
      "return-type": "json",
      "on-click": "~/scripts/weather.sh"
  }
}
