{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 6,

  "modules-left": ["custom/logo", "sway/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [ "tray", "pulseaudio", "network", "battery"],

  "clock": {
      "format": "{:%d %b %H:%M}",
      "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "sway/workspaces": {
    "format": "{icon}",
    "persistent-workspaces": {
      "1": [], "2": [], "3": [], "4": [], "5": []
    },
    "format-icons": {
      "1": "\uf120",
      "2": "\uf0ac",
      "3": "\uf121",
      "4": "\uf249",
      "5": "\uf001",
      "default": "⬤"
    }
  },

  "battery": {
    "format": " {capacity}%",
    "format-charging": " {capacity}%",
    "format-warning": " {capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    }
  },

  "mpd": {
    "format": "{stateIcon} {title}",
    "tooltip-format": "{album} - {artist} - {title}",
    "max-length": 10,
    "on-click": "mpc toggle",
    "on-click-right": "mpc next",
    "state-icons": {
        "paused": "",
        "playing": ""
    },
    "format-stopped": "\uf04d"
  },
  
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
        "activated": "\uf06e",
        "deactivated": "\uf070"
    }
},

  "network": {
      "format-wifi": " {signalStrength}%",
      "format-ethernet": "\uf796 {ifname}",
      "format-disconnected": "\uf127",
      "tooltip-format": "{ifname} {ipaddr}/{cidr}",
      "max-length": 10,
      "on-click": "nm-connection-editor"
  },

  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": " mute",
    "on-click": "pavucontrol"
  },

  "tray": {
    "spacing": 8
  },

  "custom/logo": {
      "format": "\uf6cf",
      "tooltip": false
  }
}
